{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "agentGuidance": false,
  "globalDependencies": ["packages/lint/oxlint.config.ts", "oxfmt.config.ts"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "web#build": {
      "dependsOn": ["^build"],
      "env": ["SENTRY_AUTH_TOKEN", "SENTRY_URL", "SENTRY_ORG", "SENTRY_PROJECT", "SENTRY_RELEASE"],
      "outputs": ["dist/**"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$", "oxlint.config.ts", "oxlint.config.mts"],
      "outputs": [],
      "cache": true
    },
    "lint:fix": {
      "inputs": ["$TURBO_DEFAULT$", "oxlint.config.ts", "oxlint.config.mts"],
      "outputs": ["**/*.{ts,tsx,js,jsx}"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": [],
      "cache": true
    },
    "test": {
      "outputs": [],
      "cache": true
    },
    "format": {
      "inputs": ["$TURBO_DEFAULT$", "oxfmt.config.ts"],
      "outputs": ["**/*.{ts,tsx,js,jsx,json,css,md}"],
      "cache": false
    }
  }
}
