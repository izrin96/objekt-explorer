{
  "permissions": {
    "allow": [
      "Bash(bun install)",
      "Bash(bun run lint)",
      "Bash(bun run lint:*)",
      "Bash(bun run typecheck)",
      "Bash(bun run typecheck:*)",
      "Bash(bun run build)",
      "Bash(bun run build:*)",
      "Bash(bun run format)",
      "Bash(bun run check)",
      "Bash(bun run knip)",
      "Bash(bunx knip:*)",
      "Bash(bunx oxlint:*)",
      "Bash(bunx oxfmt:*)",
      "Bash(turbo run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(npm view:*)",
      "Bash(npx ctx7@latest:*)",
      "Bash(npx skills@latest:*)",
      "Bash(openspec:*)",
      "Bash(bun test:*)",
      "Bash(bun run test)",
      "Bash(bun run test:*)"
    ],
    "ask": ["Bash(git commit:*)", "Bash(git push:*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-prod-db.ts\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-changed.ts\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
