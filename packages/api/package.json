{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/routers/index.ts",
    "./*": "./src/*.ts",
    "./services/*": "./src/services/*.ts",
    "./schemas/*": "./src/schemas/*.ts"
  },
  "scripts": {
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "oxfmt .",
    "set-role": "bun run --env-file=../../.env --env-file=../../.env.local scripts/set-role.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/client-sesv2": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@better-auth/i18n": "^1.7.7",
    "@orpc/server": "^1.15.4",
    "@orpc/zod": "^1.15.4",
    "@repo/cosmo": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/lib": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "better-auth": "^1.7.7",
    "drizzle-orm": "catalog:",
    "nanoid": "^6.0.1",
    "ofetch": "catalog:",
    "slugify": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/lint": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@types/bun": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@tanstack/react-start": "^1.168.60"
  }
}
