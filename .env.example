# web
DATABASE_URL="postgres://postgres:postgres@localhost:5432/main"
INDEXER_DATABASE_URL="postgres://postgres_read:postgres_read@localhost:5433/apollo-objekts"

VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=

# VITE_CENTRIFUGO_URL=            # optional — defaults to same-origin /connection/websocket (the dev server proxies it)

BETTER_AUTH_SECRET=
SITE_URL= # public origin, e.g. https://objekt.example; read at runtime, never baked into the build
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_BUCKET=
S3_PUBLIC_URL=

SES_REGION=
SES_ACCESS_KEY=
SES_SECRET_KEY=
SES_MAIL_FROM=

VITE_LIVE_API_KEY= # getstream.io api key, get by http inspect Cosmo app request
BYPASS_LIVE_KEY=

REDIS_URL=
COSMO_KEY= # BASE64_ENCRYPTION_KEY value in Cosmo app

# centrifugo (real-time server); the web app and the worker publish to it, browsers connect through /connection
CENTRIFUGO_URL=http://localhost:8000 # internal address of the server API, never exposed publicly; locally, keep these three in .env.local and run `docker compose --env-file .env --env-file .env.local up -d centrifugo`, which publishes it on 127.0.0.1 through docker-compose.override.yml
CENTRIFUGO_API_KEY= # long random string; signs server API calls
CENTRIFUGO_TOKEN_SECRET= # long random string, not BETTER_AUTH_SECRET; signs connection tokens
# Centrifugo runs the memory engine unless both are set. Each stack uses its OWN Valkey here, never the one in
# REDIS_URL when another stack shares it: stacks on one Valkey and prefix deliver each other's messages.
# CENTRIFUGO_ENGINE_TYPE=redis
# CENTRIFUGO_ENGINE_REDIS_ADDRESS=redis://valkey:6379

# worker: set both to false on a staging worker that shares the production indexer database
WORKER_INDEXER_WRITES=true
WORKER_TOKEN_REFRESH=true
# staging worker: production Valkey URL to republish the indexer's `transfers` channel from
TRANSFERS_RELAY_FROM=

# indexer
INDEXER_RPC_RATE_LIMIT=10
INDEXER_RPC_FINALITY=60
INDEXER_RPC_ENDPOINT="https://api.mainnet.abs.xyz"
INDEXER_SQD_ENDPOINT="https://v2.archive.subsquid.io/network/abstract-mainnet"
INDEXER_SQD_API_KEY=
INDEXER_ENABLE_OBJEKTS=true
INDEXER_ENABLE_GRAVITY=true
INDEXER_COSMO_PARALLEL_COUNT=50
INDEXER_FORCE_PRETTY_LOGGER=1
