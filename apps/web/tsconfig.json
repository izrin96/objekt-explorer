{
  "extends": "@repo/tsconfig/tsconfig.bun.json",
  "compilerOptions": {
    // Paraglide compiles src/paraglide to JS typed by JSDoc
    "allowJs": true,
    "types": ["vite/client"],
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist", ".turbo"]
}
