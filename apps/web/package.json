    "@orpc/server": "^1.16.1",
    "@orpc/tanstack-query": "^1.16.1",
    "@orpc/zod": "^1.16.1",
    "@phosphor-icons/react": "^2.1.10",
    "@repo/api": "workspace:*",
    "@repo/cosmo": "workspace:*",
    "@repo/lib": "workspace:*",
    "@sentry/bun": "catalog:",
    "@sentry/react": "catalog:",
    "@stream-io/video-react-sdk": "^1.44.1",
