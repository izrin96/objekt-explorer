{
  "name": "web",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "bun run --bun --env-file=../../.env --env-file=../../.env.local vite dev",
    "build": "bun run --bun --env-file=../../.env --env-file=../../.env.local vite build",
    "build:prod": "bun run --bun vite build",
    "preview": "bun run --bun --env-file=../../.env --env-file=../../.env.local vite preview",
    "start": "bun run --bun server.ts",
    "start:preview": "bun run --bun --env-file=../../.env --env-file=../../.env.local server.ts",
    "lint": "bun run paraglide:compile && oxlint --type-aware",
    "lint:fix": "bun run paraglide:compile && oxlint --type-aware --fix",
    "paraglide:compile": "bun run --bun paraglide-js compile",
    "typecheck": "bun run paraglide:compile && tsc --noEmit",
    "test": "bun test",
    "format": "oxfmt .",
    "scan": "bunx react-scan@latest localhost:3200"
  },
  "dependencies": {
