{
  "extends": "@repo/tsconfig/tsconfig.base.json",
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", ".turbo", "lib"],
  "compilerOptions": {
    // tsc emits CommonJS for lib/: the TypeORM models' circular decorator metadata throws under ESM
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["bun"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
