{
  "name": "indexer",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "rm -rf lib/ && tsc -p tsconfig.build.json",
    "start": "squid-typeorm-migration apply && bun lib/migrate-drizzle.js && bun lib/main.js",
    "process": "bun run build && bun run --bun start",
    "migration:apply": "squid-typeorm-migration apply && bun lib/migrate-drizzle.js",
    "codegen": "squid-typeorm-codegen",
    "lint": "oxlint --type-aware --config ./oxlint.config.mts",
    "lint:fix": "oxlint --type-aware --fix --config ./oxlint.config.mts",
    "typecheck": "tsc --pretty --noEmit",
    "format": "oxfmt ."
  },
  "dependencies": {
    "@repo/cosmo": "workspace:*",
    "@repo/lib": "workspace:*",
    "@subsquid/evm-abi": "^1.0.0",
    "@subsquid/evm-codec": "^1.0.0",
    "@subsquid/evm-processor": "^1.30.1",
    "@subsquid/typeorm-migration": "^1.4.0",
    "@subsquid/typeorm-store": "^1.9.2",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "typeorm": "^0.3.31",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/lint": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@subsquid/typeorm-codegen": "^2.4.0",
    "@types/bun": "catalog:dev",
    "typescript": "catalog:dev"
  }
}
