{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "apps/web": {
      "entry": ["src/routes/**/*.{ts,tsx}", "src/{client,server,router}.tsx"],
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "apps/worker": {
      "entry": ["src/script/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/indexer": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/api": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/db": {
      "entry": ["src/**/*.ts", "*.config.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/lib": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/cosmo": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/lint": {
      "entry": ["*.ts"],
      "project": ["*.ts"]
    },
    "packages/tsconfig": {
      "entry": [],
      "project": []
    }
  },
  "ignoreIssues": {
    "apps/web/src/components/ui/**": ["exports", "types"]
  }
}
